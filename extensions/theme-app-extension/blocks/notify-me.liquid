{% assign variant = product.selected_or_first_available_variant %}

<div class="notify-me-widget" data-product-id="{{ product.id }}" data-variant-id="{{ variant.id }}">
  {% unless variant.available %}
    <div class="notify-me-form">
      <p class="notify-me-heading">This item is currently out of stock</p>
      <div class="notify-me-input-row">
        <input type="email" placeholder="Enter your email" class="notify-me-email" />
        <button class="notify-me-submit">Notify Me</button>
      </div>
      <p class="notify-me-error" style="display:none;"></p>
      <p class="notify-me-success" style="display:none;">✅ You're on the list — we'll email you when it's back.</p>
    </div>
  {% endunless %}
</div>

{% schema %}
{
  "name": "Notify Me Button",
  "target": "section",
  "settings": []
}
{% endschema %}

<style>
  .notify-me-form {
    max-width: 360px;
    padding: 16px;
    border: 1px solid #e1e1e1;
    border-radius: 8px;
    background: #fafafa;
  }
  .notify-me-heading {
    margin: 0 0 10px;
    font-size: 14px;
    font-weight: 600;
    color: #333;
  }
  .notify-me-input-row {
    display: flex;
    gap: 8px;
  }
  .notify-me-email {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 14px;
  }
  .notify-me-email:disabled {
    background: #f0f0f0;
  }
  .notify-me-submit {
    padding: 10px 16px;
    border: none;
    border-radius: 6px;
    background: #1a1a1a;
    color: #fff;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
  }
  .notify-me-submit:disabled {
    background: #999;
    cursor: not-allowed;
  }
  .notify-me-error {
    margin: 8px 0 0;
    font-size: 13px;
    color: #d82c0d;
  }
  .notify-me-success {
    margin: 0;
    font-size: 14px;
    font-weight: 500;
    color: #108043;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('.notify-me-widget').forEach(function (widget) {
      const form = widget.querySelector('.notify-me-form');
      const emailInput = widget.querySelector('.notify-me-email');
      const submitBtn = widget.querySelector('.notify-me-submit');
      const errorMsg = widget.querySelector('.notify-me-error');
      const successMsg = widget.querySelector('.notify-me-success');
      const inputRow = widget.querySelector('.notify-me-input-row');

      if (!form) return;

      function showError(message) {
        errorMsg.textContent = message;
        errorMsg.style.display = 'block';
      }

      function clearError() {
        errorMsg.style.display = 'none';
        errorMsg.textContent = '';
      }

      submitBtn.addEventListener('click', async function () {
        clearError();
        const email = emailInput.value.trim();

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          showError('Please enter a valid email address.');
          return;
        }

        submitBtn.disabled = true;
        emailInput.disabled = true;
        submitBtn.textContent = 'Submitting...';

        try {
          const response = await fetch('/apps/back-in-stock/api/waitlist/signup', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              productId: widget.dataset.productId,
              variantId: widget.dataset.variantId,
              email: email,
              shop: Shopify.shop
            })
          });

          if (response.ok) {
            inputRow.style.display = 'none';
            successMsg.style.display = 'block';
          } else {
            showError('Something went wrong. Please try again.');
            submitBtn.disabled = false;
            emailInput.disabled = false;
            submitBtn.textContent = 'Notify Me';
          }
        } catch (err) {
          showError('Network error. Please check your connection and try again.');
          submitBtn.disabled = false;
          emailInput.disabled = false;
          submitBtn.textContent = 'Notify Me';
        }
      });

      // Allow Enter key to submit
      emailInput.addEventListener('keydown', function (e) {
        if (e.key === 'Enter') {
          e.preventDefault();
          submitBtn.click();
        }
      });
    });
  });
</script>